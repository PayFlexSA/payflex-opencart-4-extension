<div id="payflex-payment">
  <p class="payflex-intro">
    You will be securely redirected to Payflex to complete your purchase.
  </p>
  <div id="payflex-loading" style="display:none;" class="text-center my-3">
    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
    {{ text_loading }}
  </div>
  <div class="text-end">
    <button type="button" id="button-payflex-confirm" class="btn btn-primary btn-lg">
      {{ button_confirm }}
    </button>
  </div>
</div>

<script>
(function () {
  var btn = document.getElementById('button-payflex-confirm');
  var loading = document.getElementById('payflex-loading');

  btn.addEventListener('click', function () {
    btn.disabled = true;
    loading.style.display = 'block';

    fetch('index.php?route=extension/payflex/payment/payflex.confirm&language={{ language }}', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    })
      .then(function (response) { return response.json(); })
      .then(function (json) {
        if (json.error) {
          alert(json.error);
          btn.disabled = false;
          loading.style.display = 'none';
        } else if (json.redirect) {
          window.location.href = json.redirect;
        }
      })
      .catch(function () {
        btn.disabled = false;
        loading.style.display = 'none';
      });
  });
})();
</script>
