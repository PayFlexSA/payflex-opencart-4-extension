<!-- Payflex Product Widget -->
<div id="payflex-widget-container" class="my-3"
     data-widget-url="{{ widget_url }}"
     data-pay-type="{{ pay_type }}"></div>
<script>
(function () {
  var container  = document.getElementById('payflex-widget-container');
  var widgetUrl  = container.getAttribute('data-widget-url');
  var payType    = container.getAttribute('data-pay-type');

  function getProductPrice() {
    var specialEl = document.querySelector('.price-new');
    if (specialEl) {
      var text = specialEl.textContent || specialEl.innerText || '';
      var price = parseFloat(text.replace(/[^0-9.]/g, ''));
      if (!isNaN(price) && price > 0) return price;
    }
    return 0;
  }

  function loadPayflexWidget(price) {
    if (!container) return;
    var src = widgetUrl.replace('amount=0', 'amount=' + price);
    var existing = document.getElementById('payflex-widget-script');
    if (existing) {
      existing.remove();
    }
    var script = document.createElement('script');
    script.id  = 'payflex-widget-script';
    script.src = src;
    container.appendChild(script);
  }

  var price = getProductPrice();
  if (price > 0) {
    loadPayflexWidget(price);
  }

  // Update widget when customer selects a product variation
  document.addEventListener('change', function (e) {
    if (e.target && e.target.closest('#form-product')) {
      setTimeout(function () {
        var updated = getProductPrice();
        if (updated > 0 && typeof PayflexWidget !== 'undefined') {
          PayflexWidget.update(updated, payType);
        }
      }, 300);
    }
  });
})();
</script>
